{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "sql:allow-execute",
    "sql:allow-load",
    "sql:allow-select",
    "opener:default",
    "shell:allow-open",
    "shell:allow-execute",
    "shell:allow-spawn",
    "dialog:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "cmd",
          "cmd": "cmd.exe",
          "args": true
        },
        {
          "name": "sh",
          "cmd": "sh",
          "args": true
        },
        {
          "name": "explorer",
          "cmd": "explorer",
          "args": true
        },
        {
          "name": "open",
          "cmd": "open",
          "args": true
        },
        {
          "name": "xdg-open",
          "cmd": "xdg-open",
          "args": true
        },
        {
          "name": "code",
          "cmd": "code",
          "args": true
        },
        {
          "name": "taskmgr",
          "cmd": "taskmgr",
          "args": true
        },
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "shutdown",
          "cmd": "shutdown",
          "args": true
        },
        {
          "name": "rundll32",
          "cmd": "rundll32.exe",
          "args": true
        },
        {
          "name": "ipconfig",
          "cmd": "ipconfig",
          "args": true
        }
      ]
    }
  ]
}
