{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-center",
    "core:window:allow-set-size",
    "core:window:allow-set-position",
    "core:window:allow-set-title",
    "sql:default",
    "opener:default",
    "dialog:default",
    "shell:default",
    "updater:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        { "name": "cmd", "cmd": "cmd.exe", "args": true },
        { "name": "sh", "cmd": "sh", "args": true },
        { "name": "explorer", "cmd": "explorer", "args": true },
        { "name": "open", "cmd": "open", "args": true },
        { "name": "xdg-open", "cmd": "xdg-open", "args": true },
        { "name": "code", "cmd": "code", "args": true },
        { "name": "taskmgr", "cmd": "taskmgr", "args": true },
        { "name": "powershell", "cmd": "powershell", "args": true },
        { "name": "shutdown", "cmd": "shutdown", "args": true },
        { "name": "rundll32", "cmd": "rundll32.exe", "args": true },
        { "name": "ipconfig", "cmd": "ipconfig", "args": true }
      ]
    }
  ]
}
